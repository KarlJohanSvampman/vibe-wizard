# Server-side ElevenLabs credentials. This file is read by server/ai_gateway.py.
# Copy this file to .env and keep the API key out of all VITE_ variables.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_text_to_sound_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_PROMPT_INFLUENCE=0.35
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/main.iwsdk.scene.json",
  "assets": {
    "module": "./src/assets"
  },
  "world": {
    "xr": {
      "mode": "vr",
      "features": {
        "handTracking": {
          "required": false
        }
      }
    },
    "render": {
      "camera": {
        "position": [0, 1.65, 0],
        "lookAt": [0, 1.6, -1]
      }
    },
    "features": {
      "spatialUI": true
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "activation": "always",
      "injectOnBuild": true
    }
  }
}
